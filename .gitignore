# ── Data: users bring their own; never commit ──────────────────────────
*.tif
*.tiff
*.mp4
*.bin
*.npy
*.xlsx
*.png
suite2p/
# NOTE: .gitignore does NOT support inline comments — a `#` after a pattern
# becomes part of the pattern. Every negation below is on its own bare line.
# The one .npy we DO ship (canonical Suite2p detection settings backup):
!settings/pipeline_settings.npy
# Documentation screenshots ARE committed:
!docs/**/*.png
# Example-output figures ARE committed:
!examples/**/*.png

# ── Models: large, auto-downloaded or baked into the image ─────────────
Pretrained_models/
*.pth
*.zip

# ── Python / env cruft ─────────────────────────────────────────────────
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
.DS_Store

# ── Local config a user fills in ───────────────────────────────────────
config.json
!config.example.json

# ── GUI: remembered execution settings (per-machine) ───────────────────
gui/settings.local.json
